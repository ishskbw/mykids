rules_version = '2';

// 공공의 미술관 Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 그대로 붙여 넣고 "게시"를 누른다.
// 아래 이메일 두 개를 그림을 올릴 가족의 구글 계정으로 바꾼다.
// (이메일은 이 규칙에만 적는다. 사이트 코드에는 넣지 않아서 방문자에게 보이지 않는다.)
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mom@example.com',
          'dad@example.com'
        ];
    }

    // 미술관 내용: 누구나 볼 수 있고, 가족만 올리고 고치고 지울 수 있다
    match /arts/{id}      { allow read: if true; allow write: if isFamily(); }
    match /thumbs/{id}    { allow read: if true; allow write: if isFamily(); }
    match /originals/{id} { allow read: if true; allow write: if isFamily(); }
    match /settings/{id}  { allow read: if true; allow write: if isFamily(); }

    // 방문자 수: 누구나 읽을 수 있고, 누구나 숫자(n)를 1씩만 늘릴 수 있다 (지우기는 가족만)
    match /stats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if isFamily();
    }

    // 로그인한 사람이 가족인지 사이트가 확인하는 용도 (문서를 만들 필요는 없다)
    match /private/{id}   { allow read: if isFamily(); }
  }
}
